---
import SiteLayout from "@layouts/SiteLayout.astro";
---
<SiteLayout title="Wariours Shop — Clothes for wherever you're going" description="Everyday pieces, considered details. Find your next favorite at Wariours Shop.">
  <section class="hero relative overflow-hidden">
    <div class="hero-copy"><p class="eyebrow">THE EVERYDAY, RECONSIDERED</p><h1>Wear what<br/>moves <em>you.</em></h1><p class="hero-description">Thoughtful essentials for the days that make up a life. Made to wear on repeat.</p><a class="button button-dark" href="#shop">Shop the collection <span>↗</span></a><div class="hero-note"><span class="note-mark">✳</span>Made for real life. Designed to last.</div></div>
    <div class="hero-art" role="img" aria-label="Editorial arrangement of timeless clothing in warm natural colors"><div class="art-sun"></div><div class="art-poster">WARIOURS<br/><small>THE DAILY<br/>UNIFORM · Nº 01</small></div><div class="art-coat"><div class="coat-collar"></div><div class="coat-line"></div><div class="coat-pocket"></div></div><span class="art-stamp">NEW<br/>SEASON</span><div class="art-caption">OBJECTS TO LIVE IN <span>01 / 04</span></div></div>
  </section>
  <div class="ticker" aria-label="Our values"><span>GOOD CLOTHES, NO OCCASION NEEDED</span><b>✳</b><span>WORN OFTEN, LOVED LONGER</span><b>✳</b><span>GOOD CLOTHES, NO OCCASION NEEDED</span></div>
  <section id="shop" class="shop-section"><div class="section-head"><div><p class="eyebrow">THE FIRST EDITION</p><h2>Pieces for <em>every day.</em></h2></div><p>Easy layers. Good texture. The things<br/>you'll reach for before you think.</p></div><div class="filters" aria-label="Filter products"><button class="filter active" data-filter="all">All pieces <span data-count>00</span></button><button class="filter" data-filter="Tops">Tops</button><button class="filter" data-filter="Bottoms">Bottoms</button><button class="filter" data-filter="Layers">Layers</button><span class="sort-label">A small collection, made to mix.</span></div><div class="product-grid" data-products><div class="loading-card">A few good things are on their way…</div></div></section>
  <section class="manifesto"><div class="manifesto-mark">T.</div><div><p class="eyebrow">A NOTE ON WHAT WE MAKE</p><h2>Less, but<br/><em>better worn.</em></h2><p class="manifesto-copy">We believe the best clothes are the ones that quietly become yours. Familiar from the first wear, better with every one after.</p></div><p class="manifesto-sign">Made thoughtfully.<br/>Worn wholeheartedly.</p></section>
  <section class="newsletter"><p class="eyebrow">LETTERS FROM WARIOURS</p><h2>A little more<br/>good in your <em>inbox.</em></h2><p>New pieces, good ideas, and things worth keeping.</p><form data-newsletter><label class="sr-only" for="email">Your email address</label><input id="email" type="email" placeholder="Your email address" required/><button aria-label="Subscribe">↗</button></form><small data-newsletter-message>No noise. Unsubscribe whenever.</small></section>
  <div class="toast" data-toast role="status" aria-live="polite"></div>
  <div class="bag-overlay" data-bag-overlay><section class="bag-panel" aria-label="Your shopping bag"><div class="bag-heading"><div><p class="eyebrow">YOUR SELECTION</p><h2>Your bag <span data-bag-count>0</span></h2></div><button class="close-bag" data-close-bag aria-label="Close bag">×</button></div><div data-bag-items class="bag-items"></div><div class="bag-bottom"><div><span>Subtotal</span><strong data-subtotal>₹0</strong></div><button class="button button-dark checkout" data-checkout>Continue to checkout <span>↗</span></button><p>Shipping and taxes calculated at checkout.</p></div></section></div>
  <button class="bag-fab" data-open-bag aria-label="Open shopping bag">Bag <span data-bag-count>0</span></button>
  <script>
    type Product = { id: string; name: string; description: string; price: number; image: string; category: string };
    type BagItem = { id: string; quantity: number };
    const productsRoot = document.querySelector<HTMLElement>("[data-products]")!;
    const bagKey = "thread-bag-v1";
    let products: Product[] = [];
    let bag: BagItem[] = JSON.parse(localStorage.getItem(bagKey) || "[]");
    let currentFilter = "all";
    const formatPrice = (value: number) => new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(value);
    const toast = (message: string) => { const el = document.querySelector<HTMLElement>("[data-toast]")!; el.textContent = message; el.classList.add("show"); window.setTimeout(() => el.classList.remove("show"), 2600); };
    function drawProducts() {
      const visible = products.filter(p => currentFilter === "all" || p.category === currentFilter);
      document.querySelector("[data-count]")!.textContent = String(products.length).padStart(2, "0");
      productsRoot.innerHTML = visible.length ? visible.map((p, i) => `<article class="product-card"><div class="product-image image-${i % 4}">${p.image ? `<img src="${escapeAttr(p.image)}" alt="${escapeAttr(p.name)}" loading="lazy">` : `<div class="garment garment-${i % 4}"><span></span></div>`}<span class="product-index">WARIOURS / 0${i + 1}</span><button class="add-button" data-add="${p.id}" aria-label="Add ${escapeAttr(p.name)} to bag">+</button></div><div class="product-info"><div><h3>${escapeHtml(p.name)}</h3><p>${escapeHtml(p.description || p.category)}</p></div><strong>${formatPrice(p.price)}</strong></div></article>`).join("") : `<p class="empty-state">No pieces here yet. Check back soon.</p>`;
    }
    function escapeHtml(s: string) { return s.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!)); }
    const escapeAttr = escapeHtml;
    function drawBag() {
      bag = bag.filter(item => products.some(p => p.id === item.id));
      localStorage.setItem(bagKey, JSON.stringify(bag));
      document.querySelectorAll("[data-bag-count]").forEach(el => el.textContent = String(bag.reduce((n, i) => n + i.quantity, 0)));
      const panel = document.querySelector<HTMLElement>("[data-bag-items]")!;
      const chosen = bag.map(item => ({ item, product: products.find(p => p.id === item.id)! }));
      panel.innerHTML = chosen.length ? chosen.map(({item,product}) => `<article class="bag-item"><div class="bag-thumb">${product.image ? `<img src="${escapeAttr(product.image)}" alt="">` : "T."}</div><div class="bag-item-copy"><strong>${escapeHtml(product.name)}</strong><span>${formatPrice(product.price)}</span><div class="quantity"><button data-qty="${item.id}" data-delta="-1" aria-label="Remove one">−</button><span>${item.quantity}</span><button data-qty="${item.id}" data-delta="1" aria-label="Add one">+</button></div></div><button class="remove-item" data-remove="${item.id}" aria-label="Remove ${escapeAttr(product.name)}">×</button></article>`).join("") : `<div class="bag-empty"><span>✳</span><p>Your bag is taking a breather.</p><a href="#shop" data-close-bag>Find something good ↗</a></div>`;
      document.querySelector("[data-subtotal]")!.textContent = formatPrice(chosen.reduce((sum, x) => sum + x.product.price * x.item.quantity, 0));
    }
    document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach(b => b.addEventListener("click", () => { currentFilter = b.dataset.filter!; document.querySelectorAll("[data-filter]").forEach(x => x.classList.toggle("active", x === b)); drawProducts(); }));
    document.addEventListener("click", async event => {
      const target = event.target as HTMLElement;
      if (target.closest("[data-add]")) { const id = target.closest<HTMLElement>("[data-add]")!.dataset.add!; const item = bag.find(x => x.id === id); if (item) item.quantity = Math.min(10,item.quantity+1); else bag.push({id,quantity:1}); drawBag(); toast("Added to your bag — good choice."); }
      if (target.closest("[data-open-bag]")) document.querySelector("[data-bag-overlay]")!.classList.add("open");
      if (target.closest("[data-close-bag]")) document.querySelector("[data-bag-overlay]")!.classList.remove("open");
      const qty = target.closest<HTMLElement>("[data-qty]"); if (qty) { const item = bag.find(x => x.id === qty.dataset.qty)!; item.quantity += Number(qty.dataset.delta); if (item.quantity < 1) bag = bag.filter(x => x !== item); if (item.quantity > 10) item.quantity = 10; drawBag(); }
      const remove = target.closest<HTMLElement>("[data-remove]"); if (remove) { bag = bag.filter(x => x.id !== remove.dataset.remove); drawBag(); }
      if (target.closest("[data-checkout]")) { if (!bag.length) return toast("Your bag is empty for now."); const button = target.closest<HTMLButtonElement>("[data-checkout]")!; button.disabled=true; button.textContent="Opening secure checkout…"; try { const res=await fetch("/api/checkout",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({items:bag})}); const data=await res.json(); if (!res.ok) throw new Error(data.error); window.location.assign(data.url); } catch(e) { toast(e instanceof Error ? e.message : "Checkout couldn't start. Try again."); button.disabled=false; button.innerHTML="Continue to checkout <span>↗</span>"; } }
    });
    document.querySelector<HTMLElement>("[data-bag-overlay]")?.addEventListener("click", e => { const overlay=e.currentTarget as HTMLElement; if (e.target === overlay) overlay.classList.remove("open"); });
    document.querySelector<HTMLFormElement>("[data-newsletter]")?.addEventListener("submit", e => { e.preventDefault(); const msg=document.querySelector<HTMLElement>("[data-newsletter-message]")!; msg.textContent="You're on the list. Look out for a little note soon."; (e.currentTarget as HTMLFormElement).reset(); });
    const order = new URLSearchParams(location.search).get("order"); if (order === "success") { bag=[]; localStorage.removeItem(bagKey); toast("Payment received. Thanks for choosing Wariours Shop."); history.replaceState({},"",location.pathname); } else if (order === "cancelled") toast("Checkout cancelled. Your bag is right here.");
    fetch("/api/products").then(r=>r.json()).then((items: Product[])=>{products=items;drawProducts();drawBag();}).catch(()=>{productsRoot.innerHTML="<p class='empty-state'>The collection will be here shortly. Please come back soon.</p>";});
    drawBag();
  </script>
</SiteLayout>

