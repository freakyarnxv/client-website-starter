---
import SiteLayout from "@layouts/SiteLayout.astro";
---
<SiteLayout title="Wariours Shop — Store admin" description="Private product management"><main class="admin-shell"><div class="admin-top"><a class="brand" href="/"><span class="brand-flower">✳</span><span>Wariours Shop<span class="brand-period">.</span></span></a><span>PRIVATE STORE ADMIN</span></div><section class="admin-card"><div class="admin-heading"><p class="eyebrow">THE BACK ROOM</p><h1 data-heading>Good to see you.</h1><p data-subtitle>Sign in to take care of the collection.</p></div><form class="admin-login" data-login><label>Email<input name="email" type="email" autocomplete="username" required/></label><label>Password<input name="password" type="password" autocomplete="current-password" required/></label><button class="button button-dark" type="submit">Sign in <span>↗</span></button><p class="form-message" data-message role="alert"></p></form><section class="admin-dashboard" data-dashboard hidden><div class="dashboard-head"><div><h2>Your collection</h2><p>Add a piece, update its price, or retire it from the shop.</p></div><button class="logout-button" data-logout>Sign out</button></div><form class="product-form" data-product-form><label>Product name<input name="name" maxlength="100" required/></label><label>Category<select name="category"><option>Tops</option><option>Bottoms</option><option>Layers</option></select></label><label>Price (INR)<input name="price" type="number" min="1" step="1" required/></label><label>Image URL<input name="image" type="url" placeholder="https://…"/></label><label class="form-wide">Short description<input name="description" maxlength="180" required/></label><button class="button button-dark" type="submit">Add to collection <span>↗</span></button><p class="form-message" data-product-message role="alert"></p></form><div class="admin-products" data-admin-products></div></section></section><p class="admin-foot">WARIOURS SHOP · STORE OPERATIONS</p></main>
<script>
  type AdminProduct={id:string;name:string;category:string;price:number;active:number};
  const loginForm=document.querySelector<HTMLFormElement>("[data-login]")!; const dash=document.querySelector<HTMLElement>("[data-dashboard]")!; const message=document.querySelector<HTMLElement>("[data-message]")!;
  async function api(path:string,init:RequestInit={}) { const response=await fetch(path,{...init,headers:{"Content-Type":"application/json",...init.headers}}); const data=await response.json().catch(()=>({})); if(!response.ok) throw new Error(data.error||"Something went wrong"); return data; }
  async function showDashboard(){loginForm.hidden=true; document.querySelector("[data-heading]")!.textContent="The collection."; document.querySelector("[data-subtitle]")!.textContent="A little care goes a long way."; dash.hidden=false; await loadProducts();}
  async function loadProducts(){const items:AdminProduct[]=await api("/api/admin/products"); const esc=(s:string)=>s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!)); document.querySelector<HTMLElement>("[data-admin-products]")!.innerHTML=items.map(p=>`<article class="admin-product ${p.active?"":"retired"}"><div><strong>${esc(p.name)}</strong><span>${esc(p.category)} · ₹${p.price}${p.active?"":" · not on shop"}</span></div><div class="product-actions">${p.active?`<form data-price-form data-id="${p.id}"><input type="number" min="1" step="1" value="${p.price}" aria-label="New price for ${esc(p.name)}"/><button type="submit">Save price</button></form><button data-retire="${p.id}">Remove</button>`:""}</div></article>`).join("")||"<p class='empty-state'>No products yet. Add the first piece above.</p>";}
  api("/api/admin/session").then(d=>d.authenticated&&showDashboard()).catch(()=>{});
  loginForm.addEventListener("submit",async e=>{e.preventDefault();message.textContent="";const fields=new FormData(loginForm);try{await api("/api/admin/session",{method:"POST",body:JSON.stringify({email:fields.get("email"),password:fields.get("password")})});await showDashboard();}catch(err){message.textContent=err instanceof Error?err.message:"Sign in failed";}});
  document.querySelector("[data-logout]")?.addEventListener("click",async()=>{await api("/api/admin/session",{method:"DELETE"});location.reload();});
  document.querySelector<HTMLFormElement>("[data-product-form]")?.addEventListener("submit",async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const f=new FormData(form);const msg=document.querySelector<HTMLElement>("[data-product-message]")!;try{await api("/api/admin/products",{method:"POST",body:JSON.stringify({name:f.get("name"),category:f.get("category"),price:Number(f.get("price")),image:f.get("image"),description:f.get("description")})});form.reset();msg.textContent="Added to the collection.";await loadProducts();}catch(err){msg.textContent=err instanceof Error?err.message:"Could not add product";}});
  document.addEventListener("submit",async e=>{const form=(e.target as HTMLElement).closest<HTMLFormElement>("[data-price-form]");if(!form)return;e.preventDefault();const input=form.querySelector<HTMLInputElement>("input")!;try{await api("/api/admin/products",{method:"PATCH",body:JSON.stringify({id:form.dataset.id,price:Number(input.value)})});await loadProducts();}catch(err){alert(err instanceof Error?err.message:"Could not update price");}});
  document.addEventListener("click",async e=>{const button=(e.target as HTMLElement).closest<HTMLElement>("[data-retire]");if(!button)return;try{await api("/api/admin/products",{method:"PATCH",body:JSON.stringify({id:button.dataset.retire})});await loadProducts();}catch(err){alert(err instanceof Error?err.message:"Could not remove product");}});
</script></SiteLayout>

