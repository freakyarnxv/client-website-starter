---
interface Props {
  number: string;
  title: string;
  description: string;
  items: string[];
}

const { number, title, description, items } = Astro.props;
---

<article class="flex h-full flex-col border-t border-ink/20 pt-5">
  <p class="font-mono text-xs tracking-widest text-moss">{number} / SERVICE</p>
  <h3 class="mt-7 font-display text-2xl font-semibold tracking-tight">{title}</h3>
  <p class="mt-3 max-w-sm text-sm leading-6 text-muted">{description}</p>
  <ul class="mt-7 space-y-2 text-sm text-ink/80">
    {items.map((item) => <li class="flex items-center gap-2"><span class="text-moss" aria-hidden="true">↗</span>{item}</li>)}
  </ul>
</article>
